{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "macrion-crash-reports",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "macrion-crash-reports",
    "database_id": "04cb6dc0-446b-4f3a-be2b-7e779e8402f7",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [
    { "name": "SOURCE_LIMIT", "namespace_id": "39847031", "simple": { "limit": 30, "period": 60 } },
    { "name": "INGEST_LIMIT", "namespace_id": "39847032", "simple": { "limit": 300, "period": 60 } }
  ],
  "triggers": { "crons": ["17 * * * *"] }
}
